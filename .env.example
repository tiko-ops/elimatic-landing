# Copy to .env.local and fill in to email each demo request to contact@elimatic.se.
# Without these, requests are only saved to data/submissions.jsonl.

# Outgoing mail server for the elimatic.se mailbox (one.com)
SMTP_HOST=send.one.com
SMTP_PORT=465
SMTP_USER=contact@elimatic.se
# The password for that mailbox
SMTP_PASS=

# Optional: deliver requests to another address than the contact email in lib/site.ts.
CONTACT_TO_EMAIL=

# Optional: public site URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
